# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Every integration is optional: leave a value empty and that step is skipped
# (leads are then logged to the server console so nothing is lost while testing).

# ─── Public (shipped to the browser: never put secrets in VITE_ variables) ───
# WhatsApp number in international format, digits only (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=
# Booking page for the strategy call (Cal.com / Calendly / Google Calendar appointment link)
VITE_BOOKING_URL=
# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable.
VITE_GA_ID=

# ─── Server only ───
SITE_URL=https://vaibhavpasi.online

# Lead database (Supabase). Table schema: docs/LEADS.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Automation webhook (n8n / Make / Zapier / Google Apps Script) — receives every lead + payment as JSON
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend, e.g. "Vaibhav Pasi <hello@vaibhavpasi.online>"
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFY_EMAIL=contact@vaibhavpasi.online

# Payments (Razorpay). Without these, checkout runs in test mode and captures the buyer as a lead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs product download links (any long random string)
DOWNLOAD_SIGNING_SECRET=
# Same booking link as VITE_BOOKING_URL, returned after a paid strategy call
BOOKING_URL=

# Private file URLs for each digital product (delivered only after payment)
FILE_AI_MARKETING_PROMPT_PACK=
FILE_SOCIAL_MEDIA_CONTENT_CALENDAR=
FILE_MARKETING_STRATEGY_TEMPLATES=
FILE_FREELANCER_PROPOSAL_KIT=
FILE_WEBSITE_PLANNING_KIT=
FILE_BUSINESS_AUTOMATION_TEMPLATES=
FILE_AI_BUSINESS_TOOLKIT=

# Blog admin at /admin (GitHub sign-in). Create a GitHub OAuth App:
#   Homepage URL: https://www.vaibhavpasi.online   Callback URL: https://www.vaibhavpasi.online/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional: comma-separated GitHub usernames allowed to sign in (others are refused)
ADMIN_GITHUB_USERS=
