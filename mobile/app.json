{
  "expo": {
    "name": "Vaibhav Pasi",
    "slug": "vaibhav-pasi",
    "description": "Tech x Marketing: articles by Vaibhav Pasi.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vaibhavpasi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07131F",
    "ios": {
      "bundleIdentifier": "online.vaibhavpasi.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "online.vaibhavpasi.app",
      "adaptiveIcon": {
        "backgroundColor": "#07131F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F8FC",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#07131F" }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vaibhav Pasi needs your photos to add cover images and pictures to articles.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E2A93B",
          "defaultChannel": "articles"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://www.vaibhavpasi.online",
      "eas": {
        "projectId": ""
      }
    }
  }
}
